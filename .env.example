# Token d'intégration interne Notion (notion.so/my-integrations)
NOTION_TOKEN=

# IDs des 6 bases de données Notion (voir le README)
NOTION_INGREDIENTS_DB_ID=
NOTION_RECIPES_DB_ID=
NOTION_RECIPE_INGREDIENTS_DB_ID=
NOTION_PANTRY_DB_ID=
NOTION_WEEKLY_PLAN_DB_ID=
NOTION_SHOPPING_CHECKS_DB_ID=

# Foyer 2 (bases créées par `npm run setup:household`)
NOTION_PANTRY_DB_ID_2=
NOTION_WEEKLY_PLAN_DB_ID_2=
NOTION_SHOPPING_CHECKS_DB_ID_2=

# Clé Google AI Studio pour l'import de recettes (Gemini). Requise seulement pour l'import.
# Ne jamais commiter la vraie clé.
GEMINI_API_KEY=

# Libellés affichés dans le sélecteur de foyer (par défaut "Household 1" / "Household 2")
HOUSEHOLD_1_LABEL=
HOUSEHOLD_2_LABEL=
